# Šablona pro Streamlit secrets – NEOBSAHUJE skutečná hesla.
#
# Lokálně: zkopírujte tento soubor jako .streamlit/secrets.toml (je v .gitignore,
#          nikdy se necommituje). Streamlit Community Cloud: obsah vložte v nastavení
#          aplikace (⋮ → Settings → Secrets).

# --- Varianta A: jedno společné heslo (dosavadní stav) -------------------------
password = "ZMENTE_ME"

# --- Varianta B: samostatné účty --------------------------------------------------
# Jakmile přidáte sekci [users], přihlašuje se uživatelským jménem a heslem.
# password_hash vytvoříte v aplikaci (Správa účtů – jen administrátor) nebo příkazem
#   python tools/hash_password.py
# Role: admin | tester | owner. Účet bez `active = true` je vypnutý.
# `legacy_password = true` = účet se přihlašuje stávajícím heslem `password` výše.
#
# [users.lukas]
# name = "Lukáš"
# role = "admin"
# active = true
# legacy_password = true
#
# [users.honza]
# name = "Honza Podroužek"
# role = "tester"
# active = true
# password_hash = "VLOZTE_HASH_Z_NASTROJE"
#
# [users.martin]
# name = "Martin Štefan"
# role = "owner"
# active = false
# password_hash = "VLOZTE_HASH_Z_NASTROJE"
